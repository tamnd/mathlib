// The Worker that serves mathlib.tamnd.com. It has no script: Cloudflare serves the files of public/, which mlib site build writes. The workflow deploy runs wrangler deploy with this file. The address /decl/<name>/ is not a file, so the Worker returns 404.html, and its script opens the module page of the name.
{
  "name": "mathlib",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [{ "pattern": "mathlib.tamnd.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
